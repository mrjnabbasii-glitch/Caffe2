PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/cafe_aramesh
NODE_ENV=development
# Browser origin in development; use the public HTTPS origin in production.
APP_ORIGIN=http://localhost:5173

# Development: write recovery messages to server/.local-mail instead of sending email.
# Production: set MAIL_MODE=smtp, APP_ORIGIN=https://your-domain.example and SMTP settings.
MAIL_MODE=local
MAIL_FROM=Cafe Aramesh <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
