{
  "name": "cafe-aramesh-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ../scripts/dev-api.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "npm run build && node --test --test-concurrency=1",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
